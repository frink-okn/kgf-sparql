{
  "name": "@frink-okn/kgf-sparql",
  "version": "0.1.0",
  "description": "Comunica SPARQL engine tuned for Knowledge Graph Fragments endpoints",
  "license": "MIT",
  "main": "lib/index.js",
  "browser": {
    "./lib/index.js": "./lib/index-browser.js"
  },
  "typings": "lib/index",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kgf-sparql": "bin/kgf-sparql.js",
    "kgf-sparql-comunica": "bin/query.js"
  },
  "files": [
    "bin/**/*.js",
    "config",
    "engine-default.js",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b . && comunica-compile-config config/config-default.json > engine-default.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@comunica/actor-init-query": "^5.4.0",
    "@comunica/config-query-sparql": "^5.4.0",
    "@comunica/context-entries": "^5.4.0",
    "@comunica/query-sparql": "^5.4.0",
    "@comunica/runner": "^5.4.0",
    "@comunica/runner-cli": "^5.4.0",
    "@comunica/types": "^5.4.0",
    "@frink-okn/actor-http-throttle": "^0.1.0",
    "@frink-okn/actor-query-source-identify-hypermedia-sparql-bounded": "^0.1.0",
    "@frink-okn/actor-query-source-identify-kgf": "^0.1.0",
    "@frink-okn/actor-rdf-join-multi-bind-block": "^0.1.0",
    "@frink-okn/actor-rdf-join-multi-bind-round-trip": "^0.1.0",
    "@frink-okn/actor-rdf-join-selectivity-bound": "^0.1.0",
    "@frink-okn/actor-rdf-join-selectivity-void": "^0.1.0",
    "asynciterator": "^3.9.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frink-okn/kgf-sparql.git",
    "directory": "packages/kgf-sparql"
  }
}
