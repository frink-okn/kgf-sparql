{
  "name": "@frink-okn/actor-http-throttle",
  "version": "0.1.1",
  "description": "A Comunica HTTP actor that paces requests per host: requests in flight, requests per second, and backoff learned from 429 and 503 responses",
  "license": "MIT",
  "lsd:module": true,
  "main": "lib/index.js",
  "typings": "lib/index",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "components",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@comunica/bus-http": "~5.4.0",
    "@comunica/bus-http-invalidate": "^5.4.0",
    "@comunica/context-entries": "~5.4.0",
    "@comunica/core": "^5.4.0",
    "@comunica/mediatortype-time": "~5.4.0",
    "@comunica/types": "^5.4.0"
  },
  "scripts": {
    "build": "tsc -b . && componentsjs-generator .",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "componentsjs-generator": "^4.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frink-okn/kgf-sparql.git",
    "directory": "packages/actor-http-throttle"
  }
}
