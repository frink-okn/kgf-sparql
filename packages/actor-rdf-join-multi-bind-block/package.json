{
  "name": "@frink-okn/actor-rdf-join-multi-bind-block",
  "version": "0.1.1",
  "description": "A Comunica bind join that sends the smallest entry in blocks through every other entry that takes bindings, and an OPTIONAL join that sends its left rows in blocks the same way",
  "license": "MIT",
  "lsd:module": true,
  "main": "lib/index.js",
  "typings": "lib/index",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "components",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@comunica/bus-rdf-join": "^5.4.0",
    "@comunica/bus-rdf-join-entries-sort": "^5.4.0",
    "@comunica/context-entries": "~5.4.0",
    "@comunica/core": "^5.4.0",
    "@comunica/mediatortype-join-coefficients": "^5.4.0",
    "@comunica/types": "^5.4.0",
    "@comunica/utils-algebra": "^5.4.0",
    "@comunica/utils-iterator": "^5.0.0",
    "@comunica/utils-query-operation": "^5.4.0",
    "asynciterator": "^3.9.0"
  },
  "scripts": {
    "build": "tsc -b . && componentsjs-generator .",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "componentsjs-generator": "^4.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frink-okn/kgf-sparql.git",
    "directory": "packages/actor-rdf-join-multi-bind-block"
  }
}
