# Rewrite of registry prokn/list_diseases: expose the finite class set as VALUES.
PREFIX dc: <http://purl.org/dc/terms/>
PREFIX upcore: <http://purl.uniprot.org/core/>
PREFIX efo: <http://www.ebi.ac.uk/efo/EFO_>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT
  (?disease AS ?DiseaseURI)
  (?label AS ?Name)
  (?SAB AS ?Source)
WHERE {
  VALUES ?diseaseType { upcore:Disease efo:0000651 }
  ?disease a ?diseaseType ;
           rdfs:label ?label ;
           dc:source ?SAB .
}
