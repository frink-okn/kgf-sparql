# Minimal reproduction for Comunica issue:
# a property-path link assigned across multiple brTPF/QPF sources is probed with
# an RDF/JS variable whose value is "?o", producing the invalid URL value "??o".
PREFIX kwg-ont: <http://stko-kwg.geog.ucsb.edu/lod/ontology/>
PREFIX kwgr: <http://stko-kwg.geog.ucsb.edu/lod/resource/>

SELECT ?region WHERE {
  ?region kwg-ont:administrativePartOf+ kwgr:administrativeRegion.USA.13 .
}
LIMIT 1
